{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GD Launcher",
  "version": "1.1.1",
  "identifier": "org.gdlauncher.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GD Launcher",
        "width": 1320,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 660,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#0d0f14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
